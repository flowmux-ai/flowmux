# flowmux theme — example
#
# Copy this file to `$XDG_CONFIG_HOME/flowmux/theme` (typically
# `~/.config/flowmux/theme`), edit it, then relaunch flowmux. A selected
# preset replaces this file's colors; appearance overrides take precedence.
#
# Format: `key = value` lines, `#` for comments. Hex colors are
# `#RRGGBB`. The 16-entry palette is `palette = N=#RRGGBB` repeated
# for N in 0..=15.
#
# All keys are optional. Unset values fall back to flowmux's defaults.
# The example matches those defaults, including its adjusted ANSI black slots.

# Font ------------------------------------------------------------
font-family = monospace
font-size   = 12

# Window -----------------------------------------------------------
background   = #282c34
foreground   = #ffffff
# cursor-color is intentionally omitted — flowmux mirrors Ghostty by
# following `foreground` when unset.

# 16-color ANSI palette (Tomorrow with legible dark-theme black slots) ----
palette = 0=#5c6370
palette = 1=#cc6666
palette = 2=#b5bd68
palette = 3=#f0c674
palette = 4=#81a2be
palette = 5=#b294bb
palette = 6=#8abeb7
palette = 7=#c5c8c6
palette = 8=#7f848e
palette = 9=#d54e53
palette = 10=#b9ca4a
palette = 11=#e7c547
palette = 12=#7aa6da
palette = 13=#c397d8
palette = 14=#70c0b1
palette = 15=#eaeaea
