#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

head=$(git rev-parse HEAD)
check=false
editor=false
while read -r local_ref local_oid remote_ref remote_oid; do
    # Deleting a ref does not introduce code to validate.
    [[ $local_oid =~ ^0+$ ]] && continue
    commit=$(git rev-parse --verify "$local_oid^{commit}")
    if [[ $commit != "$head" ]]; then
        echo "pre-push: check out $local_ref before pushing it; only HEAD can be validated." >&2
        exit 1
    fi
    check=true
    if [[ $remote_oid =~ ^0+$ ]] || ! git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
        editor=true
    elif ! git diff --quiet "$remote_oid" "$commit" -- editor/flowmux-editor-web; then
        editor=true
    fi
done
$check || exit 0

require_clean() {
    if [[ -n $(git status --porcelain --untracked-files=normal) ]]; then
        echo 'pre-push: commit or stash local changes (including untracked files) before pushing.' >&2
        echo 'pre-push: the tested files must match the pushed commit.' >&2
        exit 1
    fi
}
require_clean
# Git's hook environment must not redirect repositories created by tests.
for variable in $(git rev-parse --local-env-vars); do unset "$variable"; done
bash scripts/check-pre-push.sh "$editor" </dev/null
require_clean
if [[ $(git rev-parse HEAD) != "$head" ]]; then
    echo 'pre-push: HEAD changed during validation; push again.' >&2
    exit 1
fi
echo 'pre-push: local checks passed. Other-platform checks still require CI.'
